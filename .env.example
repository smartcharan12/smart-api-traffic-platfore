# Copy to .env and change the values:  cp .env.example .env
# .env is git-ignored. Never commit real credentials.

# --- PostgreSQL (used by the backend and by docker-compose's postgres container) ---
DB_URL=jdbc:postgresql://localhost:5432/smart_api
DB_USERNAME=smart_api
DB_PASSWORD=change-me-to-a-long-random-string
DB_POOL_SIZE=10

# --- Backend ---
SERVER_PORT=8080

# --- Frontend dev server: where Vite forwards /api requests ---
VITE_BACKEND_URL=http://localhost:8080
