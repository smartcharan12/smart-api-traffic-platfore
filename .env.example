# Copy to .env and fill in real values:   cp .env.example .env
# .env is git-ignored. NEVER commit real credentials. Generate secrets, for example:
#   openssl rand -base64 48      (JWT_SECRET)
#   openssl rand -base64 18      (passwords)

# --- PostgreSQL ---
# DB_URL and REDIS_URL are for local runs; docker-compose sets its own.
DB_URL=jdbc:postgresql://localhost:5432/smart_api
DB_USERNAME=smart_api
DB_PASSWORD=replace-with-a-random-password

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Security ---
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-password

# --- Grafana (docker-compose) ---
GRAFANA_ADMIN_PASSWORD=replace-with-a-password

# --- Backend (local runs) ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend dev server: where Vite forwards /api and /gateway ---
VITE_BACKEND_URL=http://localhost:8080
